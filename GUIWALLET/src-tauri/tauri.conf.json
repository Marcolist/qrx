{
  "$schema": "https://schema.tauri.app/config/1",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../src",
    "distDir": "../src",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "GUI Wallet",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": true
      },
      "path": {
        "all": false
      },
      "fs": {
        "all": false,
        "scope": [
          "$APPLOCALDATA/**",
          "$RESOURCE/**"
        ]
      }
    },
    "bundle": {
      "active": true,
      "identifier": "com.qrx.guiwallet",
      "targets": [
        "app",
        "dmg",
        "msi",
        "nsis",
        "appimage",
        "deb"
      ],
      "externalBin": [
        "bin/qrx",
        "bin/qrx-cli",
        "bin/qrxd",
        "bin/qrx-btc-wallet-service"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "category": "Finance",
      "shortDescription": "QRX desktop GUI wallet",
      "longDescription": "A lightweight QUB desktop GUI wallet with bundled QUBITCOIN Core sidecars.",
      "macOS": {
        "minimumSystemVersion": "11.0"
      },
      "windows": {
        "wix": {
          "language": "en-US"
        }
      },
      "resources": [
        "resources/qrx-gateway-kraken.py",
        "resources/qrx-arbitrage-engine.py",
        "resources/qrx-complete-ledger-export.py"
      ]
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; media-src 'self' asset: https://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    },
    "windows": [
      {
        "title": "GUI Wallet",
        "width": 1440,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
