macos-x64|cpu|LLAMA_CPP_CPU|macos|x86_64|cpu|FP32|1024|0|0
macos-arm64|metal|LLAMA_CPP_METAL|macos|aarch64|other|FP16,FP32,METAL|2048|0|0
windows-x64|cpu|LLAMA_CPP_CPU|windows|x86_64|cpu|FP32|1024|0|0
linux-x64|cuda|LLAMA_CPP_CUDA|linux|x86_64|cuda|FP16,FP32,CUDA|2048|6|1
