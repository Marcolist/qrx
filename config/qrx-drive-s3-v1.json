{
  "version": 1,
  "feature": "qrx_drive_s3_gateway",
  "auth": [
    "aws_sigv4",
    "scoped_revocable_credentials"
  ],
  "operations": [
    "ListBuckets",
    "CreateBucket",
    "DeleteBucket",
    "PutObject",
    "GetObject",
    "HeadObject",
    "DeleteObject",
    "ListObjectsV2",
    "CreateMultipartUpload",
    "UploadPart",
    "CompleteMultipartUpload",
    "AbortMultipartUpload"
  ],
  "features": [
    "range_get",
    "user_metadata",
    "presigned_get",
    "presigned_put",
    "version_ids"
  ],
  "security": {
    "wallet_private_key_as_s3_secret": false,
    "private_pq_below_gateway": true,
    "authorization_scope_required": true
  }
}
